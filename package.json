{
  "name": "rss-agent-viewer",
  "version": "0.3.11",
  "description": "CLI RSS/Atom feed viewer with automatic feed discovery (bundled)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "rss-viewer": "bin/rss-viewer"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:unit": "vitest test/unit",
    "test:integration": "vitest test/integration",
    "test:coverage": "vitest --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test:build": "tsc --project tsconfig.test.json"
  },
  "keywords": [
    "rss",
    "atom",
    "feed",
    "reader",
    "cli",
    "viewer",
    "rss-agent",
    "discovery"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brooksy4503/rss-agent-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/brooksy4503/rss-agent-viewer/issues"
  },
  "homepage": "https://github.com/brooksy4503/rss-agent-viewer#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.0.1",
    "rss-agent-discovery": "^0.1.5",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
